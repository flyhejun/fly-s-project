# ISKBoard 网关配置模板
# 复制为 isk_gateway.conf 后填写真实值（isk_gateway.conf 已在 .gitignore 中）
# 格式：key=value，一行一个，# 开头是注释
# 注意：等号两侧不要加空格（解析器按 "key=value" 精确前缀匹配）

host=121.40.252.238
port=1884
# 网关直连 ThingsBoard：username/password 填设备访问令牌（Device Access Token）
username=<ThingsBoard 设备访问令牌>
password=<ThingsBoard 设备访问令牌>
target_mac=58:8c:81:0e:4e:16